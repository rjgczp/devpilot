# Copy to .env and replace the two blank values before starting locally.
POSTGRES_USER=devpilot
POSTGRES_DB=devpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Go service environment (the Go process does not load .env automatically).
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# Explicit local HTTP exception. Production defaults to HTTPS secure policy.
AUTH_MODE=development
AUTH_ORIGIN=http://127.0.0.1:8080
SESSION_TTL=24h
