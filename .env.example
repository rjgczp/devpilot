# Copy to .env and replace the two blank values before starting locally.
POSTGRES_USER=devpilot
POSTGRES_DB=devpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Go service environment (the Go process does not load .env automatically).
HTTP_ADDR=:8080
LOG_LEVEL=info
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
