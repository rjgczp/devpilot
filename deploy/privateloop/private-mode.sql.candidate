-- INACTIVE CANDIDATE for future Migration14. Not scanned/applied by Goose.
-- Separate approval required even for a disposable test DB/private Gate.
-- No Migration11; Migration1-13 files remain untouched.
BEGIN;
SET LOCAL statement_timeout='2s';
SET LOCAL transaction_timeout='2s';
SET LOCAL lock_timeout='250ms';
DO $$ BEGIN
 IF EXISTS(SELECT 1 FROM public.scheduler_control WHERE control_id='deployment' AND (gate<>'closed' OR NOT emergency_stop))
 OR EXISTS(SELECT 1 FROM public.monitor_runs WHERE physical_release_confirmed_at IS NULL)
 THEN RAISE EXCEPTION 'closed gate and independent physical stop required' USING ERRCODE='55000'; END IF;
END $$;
ALTER TABLE public.scheduler_control ADD COLUMN execution_mode text NOT NULL DEFAULT 'fixture' CHECK(execution_mode IN ('fixture','private-isolated'));
ALTER TABLE public.scheduler_control DROP CONSTRAINT scheduler_control_gate_check;
ALTER TABLE public.scheduler_control ADD CONSTRAINT scheduler_control_gate_check CHECK(gate IN ('closed','fixture','private-isolated'));

-- Internal predicate: no runtime EXECUTE. Admission matches the registered
-- incarnation mode. A private incarnation can NEVER use the fixture Gate.
CREATE FUNCTION scheduler_private.private_gate_allows(p_gate text,p_incarnation uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private AS $$
BEGIN
 IF p_gate IS NULL OR p_gate NOT IN ('fixture','private-isolated') THEN RETURN false; END IF;
 IF p_gate='private-isolated' AND NOT EXISTS(SELECT 1 FROM public.scheduler_control WHERE control_id='deployment' AND execution_mode='private-isolated') THEN RETURN false; END IF;
 IF p_incarnation IS NULL THEN RETURN true; END IF;
 RETURN EXISTS(SELECT 1 FROM public.scheduler_control WHERE incarnation=p_incarnation AND login_name=session_user AND execution_mode=p_gate);
END $$;
ALTER FUNCTION scheduler_private.private_gate_allows(text,uuid) OWNER TO devpilot_scheduler_owner;
REVOKE ALL ON FUNCTION scheduler_private.private_gate_allows(text,uuid) FROM PUBLIC;

-- Only new runtime privilege: own-incarnation boolean readiness, not row data.
CREATE FUNCTION scheduler_private.private_worker_ready(p_incarnation uuid)
RETURNS boolean LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 RETURN EXISTS(SELECT 1 FROM public.scheduler_control d WHERE d.control_id='deployment' AND d.gate='private-isolated' AND NOT d.emergency_stop AND d.expires_at>clock_timestamp() AND scheduler_private.private_gate_allows(d.gate,p_incarnation));
END $$;
ALTER FUNCTION scheduler_private.private_worker_ready(uuid) OWNER TO devpilot_scheduler_owner;
REVOKE ALL ON FUNCTION scheduler_private.private_worker_ready(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION scheduler_private.private_worker_ready(uuid) TO devpilot_scheduler_worker;

-- authorize: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.authorize(p_digest bytea,p_wid uuid,p_pid uuid,p_mid uuid,p_tag_mid uuid,p_v bigint,p_g bigint,p_body_v bigint,p_seconds integer)
RETURNS TABLE(decision text,data jsonb,retry_after integer) LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private AS $$
DECLARE
 uid uuid; user_status text; protected boolean:=false; member_role text; found_id uuid;
 current_v bigint; current_g bigint; old_desired text; cooling timestamptz;
 gate_now timestamptz; permitted boolean; auth_row public.monitor_schedules%ROWTYPE;
BEGIN
 IF p_seconds IS NULL OR p_seconds<60 OR p_seconds>86400 OR p_body_v IS NULL OR p_body_v<=0 OR octet_length(p_digest)<>32 THEN
  RAISE EXCEPTION 'invalid authorization input' USING ERRCODE='22023';
 END IF;
 SELECT s.user_id INTO uid FROM public.sessions s WHERE s.token_hash=p_digest;
 IF uid IS NULL THEN RETURN QUERY SELECT 'unauthenticated',NULL::jsonb,0; RETURN; END IF;
 SELECT u.status INTO user_status FROM public.users u WHERE u.id=uid FOR SHARE;
 IF user_status IS DISTINCT FROM 'active' THEN RETURN QUERY SELECT 'unauthenticated',NULL::jsonb,0; RETURN; END IF;
 PERFORM 1 FROM public.sessions s WHERE s.token_hash=p_digest AND s.user_id=uid AND s.revoked_at IS NULL FOR SHARE;
 IF NOT FOUND THEN RETURN QUERY SELECT 'unauthenticated',NULL::jsonb,0; RETURN; END IF;
 SELECT w.id INTO found_id FROM public.workspaces w WHERE w.id=p_wid
  AND EXISTS(SELECT 1 FROM public.workspace_members b WHERE b.workspace_id=w.id AND b.user_id=uid) FOR NO KEY UPDATE;
 protected:=FOUND;
 IF protected THEN
  SELECT b.role INTO member_role FROM public.workspace_members b WHERE b.workspace_id=p_wid AND b.user_id=uid FOR UPDATE;
  IF member_role='owner' THEN
   PERFORM 1 FROM public.projects p WHERE p.workspace_id=p_wid AND p.id=p_pid FOR UPDATE;
   IF FOUND THEN
    PERFORM 1 FROM public.http_monitors m WHERE m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid FOR UPDATE;
    IF FOUND THEN
     PERFORM 1 FROM public.monitor_activation_states a WHERE a.workspace_id=p_wid AND a.project_id=p_pid AND a.monitor_id=p_mid FOR UPDATE;
     IF NOT FOUND THEN RAISE EXCEPTION 'activation missing' USING ERRCODE='23514'; END IF;
     PERFORM 1 FROM public.monitor_schedules s WHERE s.workspace_id=p_wid AND s.project_id=p_pid AND s.monitor_id=p_mid FOR UPDATE;
     -- Capacity first in the fixed budget order. Do not wait for this after
     -- checking session expiry. Operational callers cannot take it then a parent.
     IF NOT FOUND THEN
      PERFORM 1 FROM public.scheduler_budget_state b WHERE b.kind='global' AND b.budget_key='global' FOR UPDATE;
     END IF;
    END IF;
   END IF;
  END IF;
 END IF;
 PERFORM 1 FROM public.scheduler_control c WHERE c.control_id='deployment' FOR SHARE;
 -- New SPI statement after ALL waits, fresh READ COMMITTED snapshot and time.
 gate_now:=clock_timestamp();
 PERFORM 1 FROM public.sessions s JOIN public.users u ON u.id=s.user_id WHERE s.token_hash=p_digest AND u.id=uid
  AND u.status='active' AND s.revoked_at IS NULL AND s.expires_at>gate_now;
 IF NOT FOUND THEN RETURN QUERY SELECT 'unauthenticated',NULL::jsonb,0; RETURN; END IF;
 SELECT b.role,m.version,a.activation_generation,a.desired_state,a.next_enable_allowed_at
 INTO member_role,current_v,current_g,old_desired,cooling
 FROM public.workspace_members b JOIN public.projects p ON p.workspace_id=b.workspace_id AND p.id=p_pid
 JOIN public.http_monitors m ON m.workspace_id=p.workspace_id AND m.project_id=p.id AND m.id=p_mid
 JOIN public.monitor_activation_states a ON a.workspace_id=m.workspace_id AND a.project_id=m.project_id AND a.monitor_id=m.id
 WHERE b.workspace_id=p_wid AND b.user_id=uid AND protected;
 IF NOT FOUND THEN RETURN QUERY SELECT 'not_found',NULL::jsonb,0; RETURN; END IF;
 IF member_role<>'owner' THEN RETURN QUERY SELECT 'forbidden',NULL::jsonb,0; RETURN; END IF;
 IF p_g IS NULL THEN RETURN QUERY SELECT 'required',NULL::jsonb,0; RETURN; END IF;
 IF p_tag_mid IS DISTINCT FROM p_mid OR current_v IS DISTINCT FROM p_v OR current_g IS DISTINCT FROM p_g OR current_v<>p_body_v THEN
  RETURN QUERY SELECT 'failed',NULL::jsonb,0; RETURN;
 END IF;
 IF current_g=9223372036854775807 THEN RAISE EXCEPTION 'generation exhausted' USING ERRCODE='22003'; END IF;
 IF old_desired<>'enabled' AND (SELECT count(*) FROM public.monitor_activation_states a WHERE a.workspace_id=p_wid AND a.desired_state='enabled')>=100 THEN
  RETURN QUERY SELECT 'limit',NULL::jsonb,0; RETURN;
 END IF;
 IF cooling>gate_now THEN RETURN QUERY SELECT 'cooling',NULL::jsonb,GREATEST(1,ceil(extract(epoch FROM cooling-gate_now))::integer); RETURN; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.monitor_schedules s WHERE s.workspace_id=p_wid AND s.project_id=p_pid AND s.monitor_id=p_mid)
 AND (SELECT b.schedule_count FROM public.scheduler_budget_state b WHERE b.kind='global' AND b.budget_key='global')>=10000 THEN
  RETURN QUERY SELECT 'retention_capacity',NULL::jsonb,0; RETURN;
 END IF;
 SELECT COALESCE((c.gate='fixture' OR (c.gate='private-isolated' AND EXISTS(SELECT 1 FROM public.scheduler_control private_mode WHERE private_mode.control_id='deployment' AND private_mode.execution_mode='private-isolated'))),false) AND NOT c.emergency_stop AND c.expires_at>gate_now AND c.disk_used_bytes<c.disk_budget_bytes*0.8
 INTO permitted FROM public.scheduler_control c WHERE c.control_id='deployment';
 UPDATE public.monitor_activation_states a SET desired_state='enabled',activation_configuration_version=current_v,
  activation_generation=current_g+1,next_enable_allowed_at=GREATEST(a.next_enable_allowed_at,gate_now+interval '60 seconds'),
  last_transition_kind='owner_enabled',last_actor_user_id=uid,updated_at=GREATEST(a.updated_at,gate_now)
 WHERE a.workspace_id=p_wid AND a.project_id=p_pid AND a.monitor_id=p_mid AND a.activation_generation=current_g;
 INSERT INTO public.monitor_schedules(workspace_id,project_id,monitor_id,authorized_configuration_version,authorized_activation_generation,consent_protocol,issued_at,expires_at,next_due_at,blocked_reason,created_at,updated_at)
 VALUES(p_wid,p_pid,p_mid,current_v,current_g+1,1,gate_now,gate_now+p_seconds*interval '1 second',CASE WHEN permitted THEN gate_now END,CASE WHEN permitted THEN NULL ELSE 'scheduler_unavailable' END,gate_now,gate_now)
 ON CONFLICT(workspace_id,project_id,monitor_id) DO UPDATE SET authorized_configuration_version=EXCLUDED.authorized_configuration_version,
  authorized_activation_generation=EXCLUDED.authorized_activation_generation,consent_protocol=1,issued_at=gate_now,expires_at=EXCLUDED.expires_at,
  scheduler_epoch=public.monitor_schedules.scheduler_epoch+1,next_run_id=uuidv7(),next_due_at=CASE WHEN permitted THEN GREATEST(gate_now,public.monitor_schedules.next_start_not_before) END,
  blocked_reason=EXCLUDED.blocked_reason,updated_at=GREATEST(public.monitor_schedules.updated_at,gate_now)
 RETURNING * INTO auth_row;
 RETURN QUERY SELECT 'ok',jsonb_build_object('workspace_id',p_wid,'project_id',p_pid,'monitor_id',p_mid,
  'configuration_version',current_v::text,'activation_generation',(current_g+1)::text,'scheduler_epoch',auth_row.scheduler_epoch::text,
  'issued_at',gate_now,'expires_at',auth_row.expires_at,'effective_authorization',COALESCE(permitted,false),'blocked_reason',auth_row.blocked_reason),0;
END $$;

-- execution_status: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.execution_status(p_digest bytea,p_wid uuid,p_pid uuid,p_mid uuid)
RETURNS TABLE(decision text,data jsonb) LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private AS $$
WITH gate_time AS MATERIALIZED(SELECT clock_timestamp() AS now), identity AS MATERIALIZED (
 SELECT u.id FROM public.users u JOIN public.sessions s ON s.user_id=u.id CROSS JOIN gate_time t
 WHERE s.token_hash=p_digest AND u.status='active' AND s.revoked_at IS NULL AND s.expires_at>t.now
), scoped AS MATERIALIZED (
 SELECT m.workspace_id,m.project_id,m.id monitor_id,m.version,a.activation_generation,a.desired_state,
 s.authorized_configuration_version,s.authorized_activation_generation,s.scheduler_epoch,s.expires_at,s.next_due_at,
 c.gate,c.emergency_stop,c.expires_at deployment_expires,c.disk_used_bytes,c.disk_budget_bytes,t.now,
 EXISTS(SELECT 1 FROM public.workspace_members o JOIN public.users u ON u.id=o.user_id WHERE o.workspace_id=m.workspace_id AND o.role='owner' AND u.status='active') has_owner,
 la.attempt,lc.observation,co.observation current_observation,
 la.v attempt_v,la.g attempt_g,la.e attempt_e,la.state attempt_state,
 co.v completed_v,co.g completed_g,co.e completed_e,
 EXISTS(SELECT 1 FROM public.monitor_runs r WHERE r.workspace_id=m.workspace_id AND r.project_id=m.project_id AND r.monitor_id=m.id AND r.started_at IS NOT NULL AND r.physical_release_confirmed_at IS NULL) in_flight,
 EXISTS(SELECT 1 FROM public.monitor_runs r WHERE r.workspace_id=m.workspace_id AND r.project_id=m.project_id AND r.monitor_id=m.id AND r.attempt_state IN ('unknown','completed') AND r.physical_release_confirmed_at IS NULL) quarantined
 FROM identity i JOIN public.workspace_members b ON b.user_id=i.id AND b.workspace_id=p_wid AND b.role IN ('owner','member')
 JOIN public.projects p ON p.workspace_id=b.workspace_id AND p.id=p_pid
 JOIN public.http_monitors m ON m.workspace_id=p.workspace_id AND m.project_id=p.id AND m.id=p_mid
 JOIN public.monitor_activation_states a ON a.workspace_id=m.workspace_id AND a.project_id=m.project_id AND a.monitor_id=m.id
 LEFT JOIN public.monitor_schedules s ON s.workspace_id=m.workspace_id AND s.project_id=m.project_id AND s.monitor_id=m.id
 CROSS JOIN gate_time t CROSS JOIN public.scheduler_control c
 LEFT JOIN LATERAL (
  SELECT jsonb_build_object('workspace_id',r.workspace_id,'project_id',r.project_id,'monitor_id',r.monitor_id,'run_id',r.run_id,
   'configuration_version',r.configuration_version::text,'activation_generation',r.activation_generation::text,'scheduler_epoch',r.scheduler_epoch::text,'fencing_token',r.fencing_token::text,
   'attempt_state',r.attempt_state,'scheduled_at',r.scheduled_at,'claimed_at',r.claimed_at,'started_at',r.started_at,'finished_at',r.finished_at,
   'duration_ms',r.duration_ms,'http_status',r.http_status,'success',r.success,'failure_code',r.failure_code,'stop_reason',r.stop_reason) attempt,
   r.configuration_version v,r.activation_generation g,r.scheduler_epoch e,r.attempt_state state
  FROM public.monitor_runs r WHERE r.workspace_id=m.workspace_id AND r.project_id=m.project_id AND r.monitor_id=m.id
  ORDER BY r.claimed_at DESC,r.fencing_token DESC LIMIT 1
 ) la ON true
 LEFT JOIN LATERAL (
  SELECT jsonb_build_object('workspace_id',r.workspace_id,'project_id',r.project_id,'monitor_id',r.monitor_id,'run_id',r.run_id,
   'configuration_version',r.configuration_version::text,'activation_generation',r.activation_generation::text,'scheduler_epoch',r.scheduler_epoch::text,'fencing_token',r.fencing_token::text,
   'attempt_state',r.attempt_state,'scheduled_at',r.scheduled_at,'claimed_at',r.claimed_at,'started_at',r.started_at,'finished_at',r.finished_at,
   'duration_ms',r.duration_ms,'http_status',r.http_status,'success',r.success,'failure_code',r.failure_code,'stop_reason',r.stop_reason) observation,
   r.configuration_version v,r.activation_generation g,r.scheduler_epoch e
  FROM public.monitor_runs r WHERE r.workspace_id=m.workspace_id AND r.project_id=m.project_id AND r.monitor_id=m.id AND r.attempt_state='completed'
  ORDER BY r.finished_at DESC,r.run_id DESC LIMIT 1
 ) lc ON true
 -- Current observation follows the independently gated Result pointer. A later
 -- historical audit commit cannot select itself merely by finishing last.
 LEFT JOIN LATERAL (
  SELECT jsonb_build_object('workspace_id',r.workspace_id,'project_id',r.project_id,'monitor_id',r.monitor_id,'run_id',r.run_id,
   'configuration_version',r.configuration_version::text,'activation_generation',r.activation_generation::text,'scheduler_epoch',r.scheduler_epoch::text,'fencing_token',r.fencing_token::text,
   'attempt_state',r.attempt_state,'scheduled_at',r.scheduled_at,'claimed_at',r.claimed_at,'started_at',r.started_at,'finished_at',r.finished_at,
   'duration_ms',r.duration_ms,'http_status',r.http_status,'success',r.success,'failure_code',r.failure_code,'stop_reason',r.stop_reason) observation,
   r.configuration_version v,r.activation_generation g,r.scheduler_epoch e
  FROM public.monitor_runs r WHERE r.workspace_id=m.workspace_id AND r.project_id=m.project_id AND r.monitor_id=m.id AND r.attempt_state='completed' AND r.run_id=s.latest_result_run_id
   AND r.configuration_version=s.authorized_configuration_version AND r.activation_generation=s.authorized_activation_generation
  ORDER BY r.finished_at DESC,r.run_id DESC LIMIT 1
 ) co ON true
 WHERE c.control_id='deployment'
), states AS MATERIALIZED (
 SELECT *,CASE WHEN authorized_configuration_version IS NULL THEN 'none' WHEN expires_at<=now THEN 'expired' ELSE 'valid' END authorization_state,
 CASE WHEN desired_state='disabled' THEN NULL
 WHEN authorized_configuration_version IS NULL OR authorized_configuration_version<>version OR authorized_activation_generation<>activation_generation THEN 'authorization_required'
 WHEN expires_at<=now THEN 'authorization_expired'
 WHEN NOT has_owner THEN 'owner_unavailable'
 WHEN NOT COALESCE((gate='fixture' OR (gate='private-isolated' AND EXISTS(SELECT 1 FROM public.scheduler_control private_mode WHERE private_mode.control_id='deployment' AND private_mode.execution_mode='private-isolated'))),false) THEN 'scheduler_unavailable'
 WHEN emergency_stop THEN 'emergency_stop'
 WHEN deployment_expires<=now OR deployment_expires IS NULL THEN 'egress_unavailable'
 WHEN disk_used_bytes>=disk_budget_bytes*0.8 THEN 'retention_capacity'
 WHEN quarantined THEN 'quarantined'
 WHEN EXISTS(SELECT 1 FROM public.scheduler_budget_state b WHERE b.kind='global' AND b.budget_key='global'
 AND (b.terminal_count>=100000 OR b.retention_pending_count>=32 OR b.key_count+
  CASE WHEN EXISTS(SELECT 1 FROM public.scheduler_budget_state w WHERE w.kind='workspace' AND w.budget_key=workspace_id::text) THEN 0 ELSE 1 END+
  CASE WHEN EXISTS(SELECT 1 FROM public.scheduler_budget_state p WHERE p.kind='project' AND p.budget_key=workspace_id::text||'/'||project_id::text) THEN 0 ELSE 1 END+
  CASE WHEN EXISTS(SELECT 1 FROM public.scheduler_budget_state m WHERE m.kind='monitor' AND m.budget_key=workspace_id::text||'/'||project_id::text||'/'||monitor_id::text) THEN 0 ELSE 1 END>10000))
 OR EXISTS(SELECT 1 FROM public.scheduler_budget_state b WHERE (b.kind='workspace' AND b.budget_key=workspace_id::text AND b.terminal_count>=10000)
 OR (b.kind='monitor' AND b.budget_key=workspace_id::text||'/'||project_id::text||'/'||monitor_id::text AND b.terminal_count>=100))
 OR EXISTS(SELECT 1 FROM public.monitor_runs r WHERE r.workspace_id=scoped.workspace_id AND r.project_id=scoped.project_id AND r.monitor_id=scoped.monitor_id
 AND r.finished_at<=now-interval '7 days') THEN 'retention_capacity'
 ELSE NULL END reason
 FROM scoped
)
SELECT CASE WHEN NOT EXISTS(SELECT 1 FROM identity) THEN 'unauthenticated' WHEN NOT EXISTS(SELECT 1 FROM scoped) THEN 'not_found' ELSE 'ok' END,
 (SELECT jsonb_build_object('workspace_id',workspace_id,'project_id',project_id,'monitor_id',monitor_id,
 'configuration_version',version::text,'activation_generation',activation_generation::text,'scheduler_epoch',scheduler_epoch::text,
 'desired_state',desired_state,'authorization_state',authorization_state,'scheduling_state',CASE WHEN desired_state='disabled' THEN 'disabled' WHEN reason IS NOT NULL THEN 'blocked' WHEN next_due_at<=now THEN 'due' ELSE 'authorized_waiting' END,
 'effective_authorization',desired_state='enabled' AND authorization_state='valid' AND reason IS NULL,
 'expires_at',expires_at,'next_due',next_due_at,'in_flight',in_flight,'pause_semantics','start_commit','blocked_reason',reason,
 'latest_attempt',attempt,'latest_completed_observation',observation,
 'current_observation',CASE WHEN attempt_state IS DISTINCT FROM 'unknown' AND completed_v=version AND completed_g=activation_generation AND completed_e=scheduler_epoch THEN current_observation END) FROM states);
$$;

-- claim: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.claim(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_uid uuid,p_membership uuid,p_v bigint,p_g bigint,p_epoch bigint,p_run uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE s public.monitor_schedules%ROWTYPE; provisional timestamptz; gate_now timestamptz; observed_now timestamptz; previous_gate timestamptz; new_fence bigint;
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 IF p_uid IS NULL OR p_membership IS NULL OR p_run IS NULL THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,p_uid,p_membership,true);
 SELECT * INTO s FROM public.monitor_schedules x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid;
 IF s.next_run_id IS DISTINCT FROM p_run OR s.scheduler_epoch IS DISTINCT FROM p_epoch THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM 1 FROM public.monitor_runs r WHERE r.workspace_id=p_wid AND r.project_id=p_pid AND r.monitor_id=p_mid
 AND (r.attempt_state IN ('leased','started') OR r.physical_release_confirmed_at IS NULL) FOR UPDATE;
 IF FOUND THEN RAISE EXCEPTION 'candidate_busy' USING ERRCODE='P0001'; END IF;
 new_fence:=s.last_fencing_token+1;
 provisional:=GREATEST(clock_timestamp(),s.next_due_at);
 -- Initialize and lock all budget rows BEFORE the first Run INSERT.
 PERFORM scheduler_private.lock_budgets(p_wid,p_pid,p_mid);
 INSERT INTO public.monitor_runs(workspace_id,project_id,monitor_id,run_id,configuration_version,activation_generation,scheduler_epoch,fencing_token,scheduled_at,claimed_at,lease_owner,worker_incarnation,lease_until,attempt_state)
 VALUES(p_wid,p_pid,p_mid,p_run,p_v,p_g,p_epoch,new_fence,COALESCE(s.next_due_at,provisional),provisional,session_user,p_incarnation,provisional+interval '45 seconds','leased');
 UPDATE public.scheduler_budget_state SET in_use=in_use+1,active_count=active_count+1
 WHERE kind='global' AND budget_key='global' AND in_use<32 AND active_count<32;
 IF NOT FOUND THEN RAISE EXCEPTION 'resource_limited' USING ERRCODE='P0001'; END IF;
 UPDATE public.scheduler_budget_state SET in_use=in_use+1
 WHERE kind='workspace' AND budget_key=p_wid::text AND in_use<4;
 IF NOT FOUND THEN RAISE EXCEPTION 'resource_limited' USING ERRCODE='P0001'; END IF;
 UPDATE public.scheduler_budget_state SET in_use=in_use+1
 WHERE kind='project' AND budget_key=p_wid::text||'/'||p_pid::text AND in_use<2;
 IF NOT FOUND THEN RAISE EXCEPTION 'resource_limited' USING ERRCODE='P0001'; END IF;
 UPDATE public.scheduler_budget_state SET in_use=in_use+1
 WHERE kind='monitor' AND budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text AND in_use<1;
 IF NOT FOUND THEN RAISE EXCEPTION 'resource_limited' USING ERRCODE='P0001'; END IF;
 INSERT INTO public.scheduler_reservations(workspace_id,project_id,monitor_id,run_id,reservation_state) VALUES(p_wid,p_pid,p_mid,p_run,'reserved');
 PERFORM scheduler_private.lock_control(p_incarnation);
 -- Separate SPI command and fresh snapshot after every lock, including control.
 SELECT clock_timestamp(),c.last_gate_at INTO observed_now,previous_gate FROM public.scheduler_control c
 WHERE c.kind='worker' AND c.login_name=session_user AND c.incarnation=p_incarnation;
 gate_now:=GREATEST(observed_now,s.updated_at,previous_gate);
 -- A backwards step exceeding the existing2s transaction budget cannot be
 -- absorbed into this operation; refuse rather than moving durable time back.
 IF gate_now>observed_now+interval '2 seconds' THEN RAISE EXCEPTION 'clock_untrusted' USING ERRCODE='P0001'; END IF;
 PERFORM 1 FROM public.users u JOIN public.workspace_members b ON b.user_id=u.id AND b.workspace_id=p_wid
 JOIN public.projects p ON p.workspace_id=b.workspace_id AND p.id=p_pid
 JOIN public.http_monitors m ON m.workspace_id=p.workspace_id AND m.project_id=p.id AND m.id=p_mid
 JOIN public.monitor_activation_states a ON a.workspace_id=m.workspace_id AND a.project_id=m.project_id AND a.monitor_id=m.id
 JOIN public.monitor_schedules x ON x.workspace_id=m.workspace_id AND x.project_id=m.project_id AND x.monitor_id=m.id
 CROSS JOIN public.scheduler_control c
 WHERE u.id=p_uid AND u.status='active' AND b.role='owner' AND b.membership_id=p_membership
 AND m.version=p_v AND a.desired_state='enabled' AND a.activation_generation=p_g AND a.activation_configuration_version=p_v
 AND x.authorized_configuration_version=p_v AND x.authorized_activation_generation=p_g AND x.scheduler_epoch=p_epoch AND x.consent_protocol=1
 AND (x.last_started_at IS NULL OR x.last_started_at+m.interval_seconds*interval '1 second'<=gate_now)
 AND x.expires_at>gate_now AND (x.next_due_at IS NULL OR x.next_due_at<=gate_now) AND (x.next_start_not_before IS NULL OR x.next_start_not_before<=gate_now)
 AND c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>gate_now
 AND c.disk_used_bytes<c.disk_budget_bytes*0.8
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable AND
 (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready OR h.expires_at<=gate_now OR h.expires_at IS NULL));
 IF NOT FOUND OR gate_now>transaction_timestamp()+interval '2 seconds' THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 -- All capacity was reserved before control locks; only finalize its time floor now.
 UPDATE public.scheduler_budget_state SET keep_until=GREATEST(keep_until,gate_now+interval '1 hour')
 WHERE (kind='global' AND budget_key='global') OR (kind='workspace' AND budget_key=p_wid::text)
 OR (kind='project' AND budget_key=p_wid::text||'/'||p_pid::text)
 OR (kind='monitor' AND budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text);
 UPDATE public.monitor_runs SET claimed_at=gate_now,lease_until=gate_now+interval '45 seconds' WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 UPDATE public.monitor_schedules SET last_fencing_token=new_fence,last_attempt_run_id=p_run,next_due_at=NULL,blocked_reason=NULL,updated_at=GREATEST(updated_at,gate_now)
 WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=gate_now WHERE kind='worker' AND login_name=session_user AND incarnation=p_incarnation;
 RETURN jsonb_build_object('workspace_id',p_wid,'project_id',p_pid,'monitor_id',p_mid,'run_id',p_run,'configuration_version',p_v::text,
 'activation_generation',p_g::text,'scheduler_epoch',p_epoch::text,'fencing_token',new_fence::text,'claimed_at',gate_now,'lease_until',gate_now+interval '45 seconds');
END $$;

-- start_run: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.start_run(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_uid uuid,p_membership uuid,p_run uuid,p_fence bigint)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; gate_now timestamptz; observed_now timestamptz; configuration public.http_monitors%ROWTYPE;
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 IF p_uid IS NULL OR p_membership IS NULL THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,p_uid,p_membership,false);
 SELECT * INTO r FROM public.monitor_runs x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND OR r.lease_owner<>session_user OR r.worker_incarnation<>p_incarnation OR r.fencing_token<>p_fence OR r.attempt_state<>'leased' THEN
  RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_budgets(p_wid,p_pid,p_mid);
 SELECT * INTO q FROM public.scheduler_reservations x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_control(p_incarnation);
 -- The registered supervisor is also protected last, never before a parent.
 PERFORM 1 FROM public.scheduler_control c WHERE c.kind='supervisor' AND c.incarnation=q.supervisor_incarnation FOR SHARE;
 SELECT clock_timestamp() INTO observed_now;
 SELECT GREATEST(observed_now,r.claimed_at,s.updated_at,c.last_gate_at) INTO gate_now
 FROM public.monitor_schedules s CROSS JOIN public.scheduler_control c
 WHERE s.workspace_id=p_wid AND s.project_id=p_pid AND s.monitor_id=p_mid
 AND c.kind='worker' AND c.login_name=session_user AND c.incarnation=p_incarnation;
 IF gate_now>observed_now+interval '2 seconds' THEN RAISE EXCEPTION 'clock_untrusted' USING ERRCODE='P0001'; END IF;
 SELECT m.* INTO configuration FROM public.users u JOIN public.workspace_members b ON b.user_id=u.id AND b.workspace_id=p_wid
 JOIN public.projects p ON p.workspace_id=b.workspace_id AND p.id=p_pid
 JOIN public.http_monitors m ON m.workspace_id=p.workspace_id AND m.project_id=p.id AND m.id=p_mid
 JOIN public.monitor_activation_states a ON a.workspace_id=m.workspace_id AND a.project_id=m.project_id AND a.monitor_id=m.id
 JOIN public.monitor_schedules s ON s.workspace_id=m.workspace_id AND s.project_id=m.project_id AND s.monitor_id=m.id
 CROSS JOIN public.scheduler_control c
 WHERE u.id=p_uid AND u.status='active' AND b.role='owner' AND b.membership_id=p_membership
 AND m.version=r.configuration_version AND a.desired_state='enabled' AND a.activation_generation=r.activation_generation AND a.activation_configuration_version=m.version
 AND s.authorized_configuration_version=m.version AND s.authorized_activation_generation=a.activation_generation AND s.scheduler_epoch=r.scheduler_epoch AND s.consent_protocol=1
 AND s.last_fencing_token=p_fence AND s.expires_at>gate_now
 AND (s.next_start_not_before IS NULL OR s.next_start_not_before<=gate_now)
 AND (s.last_started_at IS NULL OR s.last_started_at+m.interval_seconds*interval '1 second'<=gate_now)
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_budget_state mb WHERE mb.kind='monitor' AND mb.budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text AND mb.not_before>gate_now)
 AND r.lease_until>=gate_now+(m.timeout_seconds+5)*interval '1 second'
 AND q.reservation_state='reserved' AND q.namespace_incarnation IS NOT NULL AND q.input_consumed_at IS NULL
 AND q.permit_deadline>=gate_now+m.timeout_seconds*interval '1 second' AND q.permit_deadline<=gate_now+interval '35 seconds'
 AND EXISTS(SELECT 1 FROM public.scheduler_control z WHERE z.kind='supervisor' AND z.incarnation=q.supervisor_incarnation AND z.verified_at IS NOT NULL AND NOT z.emergency_stop AND z.expires_at>gate_now)
 AND c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>gate_now AND c.disk_used_bytes<c.disk_budget_bytes*0.8
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable AND
 (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready OR h.expires_at<=gate_now OR h.expires_at IS NULL));
 IF NOT FOUND OR gate_now>transaction_timestamp()+interval '2 seconds' THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 PERFORM scheduler_private.consume_token('global','global',8000000,8000000,gate_now);
 PERFORM scheduler_private.consume_token('workspace',p_wid::text,2000000,1000000,gate_now);
 PERFORM scheduler_private.consume_token('project',p_wid::text||'/'||p_pid::text,1000000,500000,gate_now);
 UPDATE public.scheduler_budget_state SET not_before=GREATEST(not_before,gate_now+configuration.interval_seconds*interval '1 second'),keep_until=GREATEST(keep_until,gate_now+interval '1 hour')
 WHERE kind='monitor' AND budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text;
 UPDATE public.monitor_runs SET attempt_state='started',started_at=gate_now WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 UPDATE public.monitor_schedules SET last_started_at=gate_now,next_start_not_before=GREATEST(next_start_not_before,gate_now+configuration.interval_seconds*interval '1 second'),updated_at=GREATEST(updated_at,gate_now)
 WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=gate_now WHERE kind='worker' AND login_name=session_user AND incarnation=p_incarnation;
 -- URL exists only in this transient Start snapshot, never in a run or log.
 RETURN jsonb_build_object('workspace_id',p_wid,'project_id',p_pid,'monitor_id',p_mid,'run_id',p_run,
 'configuration_version',r.configuration_version::text,'activation_generation',r.activation_generation::text,'scheduler_epoch',r.scheduler_epoch::text,'fencing_token',p_fence::text,
 'started_at',gate_now,'permit_deadline',q.permit_deadline,'url',configuration.url,'timeout_seconds',configuration.timeout_seconds,'expected_status',configuration.expected_status,'interval_seconds',configuration.interval_seconds,
 'namespace_incarnation',q.namespace_incarnation,'supervisor_incarnation',q.supervisor_incarnation);
END $$;

-- prepare_run: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.prepare_run(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_run uuid,p_worker_incarnation uuid,p_namespace uuid,p_remaining_ms integer,p_manifest bytea)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; gate_now timestamptz; deadline timestamptz; previous xid8; timeout_seconds integer;
BEGIN
 PERFORM scheduler_private.system_identity('supervisor',p_incarnation);
 IF p_namespace IS NULL OR p_remaining_ms IS NULL OR p_remaining_ms<1 OR p_remaining_ms>35000 OR p_manifest IS NULL OR octet_length(p_manifest)<>32 THEN RAISE EXCEPTION 'invalid preparation' USING ERRCODE='22023'; END IF;
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,NULL,NULL,false);
 SELECT * INTO r FROM public.monitor_runs x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND OR r.worker_incarnation IS DISTINCT FROM p_worker_incarnation OR r.attempt_state<>'leased' THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_budgets(p_wid,p_pid,p_mid);
 SELECT * INTO q FROM public.scheduler_reservations x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND OR q.namespace_incarnation IS NOT NULL OR q.reservation_state<>'reserved' THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM 1 FROM public.scheduler_control c WHERE c.control_id='deployment' FOR SHARE;
 SELECT c.last_transaction INTO previous FROM public.scheduler_control c WHERE c.kind='supervisor' AND c.login_name=session_user AND c.incarnation=p_incarnation FOR UPDATE;
 IF NOT FOUND OR previous=pg_current_xact_id() THEN RAISE EXCEPTION 'one operation per transaction required' USING ERRCODE='25000'; END IF;
 SELECT clock_timestamp() INTO gate_now;
 PERFORM scheduler_private.system_identity('supervisor',p_incarnation);
 SELECT m.timeout_seconds INTO timeout_seconds FROM public.http_monitors m WHERE m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid;
 deadline:=gate_now+p_remaining_ms*interval '1 millisecond';
 IF r.lease_until<=gate_now OR deadline<gate_now+timeout_seconds*interval '1 second'
 OR NOT EXISTS(SELECT 1 FROM public.scheduler_control c WHERE c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>gate_now) THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 UPDATE public.scheduler_reservations SET namespace_incarnation=p_namespace,supervisor_incarnation=p_incarnation,prepared_at=gate_now,permit_deadline=deadline,preparation_digest=p_manifest,stop_key_id=(SELECT sha256(c.stop_public_key) FROM public.scheduler_control c WHERE c.kind='supervisor' AND c.login_name=session_user AND c.incarnation=p_incarnation) WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=gate_now WHERE kind='supervisor' AND login_name=session_user AND incarnation=p_incarnation;
 RETURN jsonb_build_object('namespace_incarnation',p_namespace,'supervisor_incarnation',p_incarnation,'permit_deadline',deadline);
END $$;

-- consume_input: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.consume_input(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_run uuid,p_namespace uuid,p_fence bigint)
RETURNS void LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; gate_now timestamptz; previous xid8;
BEGIN
 PERFORM scheduler_private.system_identity('supervisor',p_incarnation);
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,NULL,NULL,false);
 SELECT * INTO r FROM public.monitor_runs x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_budgets(p_wid,p_pid,p_mid);
 SELECT * INTO q FROM public.scheduler_reservations x WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM 1 FROM public.scheduler_control c WHERE c.control_id='deployment' FOR SHARE;
 SELECT c.last_transaction INTO previous FROM public.scheduler_control c WHERE c.kind='supervisor' AND c.login_name=session_user AND c.incarnation=p_incarnation FOR UPDATE;
 IF NOT FOUND OR previous=pg_current_xact_id() THEN RAISE EXCEPTION 'one operation per transaction required' USING ERRCODE='25000'; END IF;
 SELECT clock_timestamp() INTO gate_now;
 PERFORM scheduler_private.system_identity('supervisor',p_incarnation);
 IF r.attempt_state<>'started' OR r.fencing_token IS DISTINCT FROM p_fence OR r.lease_until<=gate_now
 OR q.reservation_state<>'reserved' OR q.supervisor_incarnation IS DISTINCT FROM p_incarnation OR q.namespace_incarnation IS DISTINCT FROM p_namespace
 OR q.input_consumed_at IS NOT NULL OR q.permit_deadline<=gate_now
 OR NOT EXISTS(SELECT 1 FROM public.scheduler_control c WHERE c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>gate_now) THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 UPDATE public.scheduler_reservations SET input_consumed_at=gate_now WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=gate_now WHERE kind='supervisor' AND login_name=session_user AND incarnation=p_incarnation;
END $$;

-- reconcile_claim: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.reconcile_claim(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_run uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE result jsonb;
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 SELECT jsonb_build_object('workspace_id',r.workspace_id,'project_id',r.project_id,'monitor_id',r.monitor_id,'run_id',r.run_id,
 'configuration_version',r.configuration_version::text,'activation_generation',r.activation_generation::text,'scheduler_epoch',r.scheduler_epoch::text,
 'fencing_token',r.fencing_token::text,'claimed_at',r.claimed_at,'lease_until',r.lease_until)
 INTO result FROM public.monitor_runs r JOIN public.monitor_schedules s USING(workspace_id,project_id,monitor_id)
 JOIN public.http_monitors m ON m.workspace_id=r.workspace_id AND m.project_id=r.project_id AND m.id=r.monitor_id
 JOIN public.monitor_activation_states a ON a.workspace_id=r.workspace_id AND a.project_id=r.project_id AND a.monitor_id=r.monitor_id
 CROSS JOIN public.scheduler_control c CROSS JOIN LATERAL (SELECT clock_timestamp() now) t
 WHERE r.workspace_id=p_wid AND r.project_id=p_pid AND r.monitor_id=p_mid AND r.run_id=p_run
 AND r.lease_owner=session_user AND r.worker_incarnation=p_incarnation AND r.attempt_state='leased' AND r.started_at IS NULL AND r.lease_until>t.now
 AND r.configuration_version=m.version AND a.desired_state='enabled' AND a.activation_generation=r.activation_generation AND a.activation_configuration_version=r.configuration_version
 AND s.authorized_configuration_version=r.configuration_version AND s.authorized_activation_generation=r.activation_generation AND s.scheduler_epoch=r.scheduler_epoch AND s.last_fencing_token=r.fencing_token AND s.expires_at>t.now
 AND EXISTS(SELECT 1 FROM public.workspace_members b JOIN public.users u ON u.id=b.user_id WHERE b.workspace_id=p_wid AND b.role='owner' AND u.status='active')
 AND c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>t.now
 AND c.disk_used_bytes<c.disk_budget_bytes*0.8
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable AND
 (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready OR h.expires_at<=t.now OR h.expires_at IS NULL));
 RETURN result;
END $$;

-- reserve_target: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.reserve_target(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_uid uuid,p_membership uuid,p_run uuid,p_fence bigint,p_key_generation bigint,p_origin_key text,p_ip_key text) RETURNS jsonb
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; d public.scheduler_control%ROWTYPE; keys jsonb; key_row record; n timestamptz; observed timestamptz; permit uuid;
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 IF p_uid IS NULL OR p_membership IS NULL OR p_key_generation IS NULL OR p_origin_key IS NULL OR p_ip_key IS NULL THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,p_uid,p_membership,false);
 SELECT * INTO r FROM public.monitor_runs WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND OR r.attempt_state<>'started' OR r.lease_owner<>session_user OR r.worker_incarnation<>p_incarnation OR r.fencing_token<>p_fence THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_budgets(p_wid,p_pid,p_mid);
 -- Rotation also holds global, so this catalog cannot change during target locks.
 SELECT * INTO STRICT d FROM public.scheduler_control WHERE control_id='deployment';
 SELECT i->'keys' INTO keys FROM jsonb_array_elements(d.target_catalog) i WHERE i->>'workspace_id'=p_wid::text AND i->>'project_id'=p_pid::text AND i->>'monitor_id'=p_mid::text
 AND i->>'configuration_version'=r.configuration_version::text AND EXISTS(SELECT 1 FROM jsonb_array_elements(i->'keys') k WHERE k->>'generation'=p_key_generation::text AND k->>'origin_key'=p_origin_key AND k->>'ip_key'=p_ip_key) LIMIT 1;
 IF keys IS NULL OR d.target_key_generation<>p_key_generation THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 FOR key_row IN SELECT kind,budget_key FROM (
  SELECT 'origin'::text kind,k->>'origin_key' budget_key FROM jsonb_array_elements(keys) k
  UNION SELECT 'ip',k->>'ip_key' FROM jsonb_array_elements(keys) k
 ) target_keys ORDER BY CASE kind WHEN 'origin' THEN 0 ELSE 1 END,budget_key LOOP
  PERFORM 1 FROM public.scheduler_budget_state b WHERE b.kind=key_row.kind AND b.budget_key=key_row.budget_key FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 END LOOP;
 SELECT * INTO q FROM public.scheduler_reservations WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND OR q.target_permit_id IS NOT NULL THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_control(p_incarnation);
 PERFORM 1 FROM public.scheduler_control c WHERE c.kind='supervisor' AND c.incarnation=q.supervisor_incarnation FOR SHARE;
 SELECT clock_timestamp() INTO observed;
 SELECT GREATEST(observed,r.started_at,c.last_gate_at) INTO n FROM public.scheduler_control c WHERE c.kind='worker' AND c.login_name=session_user AND c.incarnation=p_incarnation;
 IF n>observed+interval '2 seconds' THEN RAISE EXCEPTION 'clock_untrusted' USING ERRCODE='P0001'; END IF;
 -- Fresh SPI snapshot after all waits; the one saved clock gates every DML.
 PERFORM 1 FROM public.users u JOIN public.workspace_members b ON b.user_id=u.id AND b.workspace_id=p_wid
 JOIN public.http_monitors m ON m.workspace_id=b.workspace_id AND m.project_id=p_pid AND m.id=p_mid
 JOIN public.monitor_activation_states a ON a.workspace_id=m.workspace_id AND a.project_id=m.project_id AND a.monitor_id=m.id
 JOIN public.monitor_schedules s ON s.workspace_id=m.workspace_id AND s.project_id=m.project_id AND s.monitor_id=m.id
 CROSS JOIN public.scheduler_control c
 WHERE u.id=p_uid AND u.status='active' AND b.membership_id=p_membership AND b.role='owner'
 AND m.version=r.configuration_version AND a.desired_state='enabled' AND a.activation_configuration_version=m.version AND a.activation_generation=r.activation_generation
 AND s.scheduler_epoch=r.scheduler_epoch AND s.authorized_configuration_version=m.version AND s.authorized_activation_generation=a.activation_generation AND s.last_fencing_token=p_fence AND s.expires_at>n
 AND r.lease_until>=n+(m.timeout_seconds+5)*interval '1 second'
 AND q.reservation_state='reserved' AND q.input_consumed_at IS NOT NULL AND q.input_consumed_at>=r.started_at AND q.permit_deadline>=n+m.timeout_seconds*interval '1 second'
 AND q.permit_deadline<=r.started_at+interval '35 seconds'
 AND EXISTS(SELECT 1 FROM public.scheduler_control z WHERE z.kind='supervisor' AND z.incarnation=q.supervisor_incarnation AND z.verified_at IS NOT NULL AND NOT z.emergency_stop AND z.expires_at>n)
 AND c.control_id='deployment' AND scheduler_private.private_gate_allows(c.gate,p_incarnation) AND NOT c.emergency_stop AND c.expires_at>n AND c.disk_used_bytes<c.disk_budget_bytes*0.8
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable AND (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready OR h.expires_at<=n OR h.expires_at IS NULL));
 IF NOT FOUND OR n>transaction_timestamp()+interval '2 seconds' THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 FOR key_row IN SELECT kind,budget_key FROM (
  SELECT 'origin'::text kind,k->>'origin_key' budget_key FROM jsonb_array_elements(keys) k
  UNION SELECT 'ip',k->>'ip_key' FROM jsonb_array_elements(keys) k
 ) target_keys ORDER BY CASE kind WHEN 'origin' THEN 0 ELSE 1 END,budget_key LOOP
  UPDATE public.scheduler_budget_state SET in_use=in_use+1,keep_until=GREATEST(keep_until,n+interval '1 hour')
  WHERE kind=key_row.kind AND budget_key=key_row.budget_key AND in_use<CASE key_row.kind WHEN 'origin' THEN 1 ELSE 2 END;
  IF NOT FOUND THEN RAISE EXCEPTION 'resource_limited' USING ERRCODE='P0001'; END IF;
  PERFORM scheduler_private.consume_target_token(key_row.kind,key_row.budget_key,n);
 END LOOP;
 permit:=uuidv7();
 UPDATE public.scheduler_reservations SET origin_key=p_origin_key,ip_key=p_ip_key,target_keys=keys,target_permit_id=permit,target_permit_committed_at=n WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=n WHERE kind='worker' AND login_name=session_user AND incarnation=p_incarnation;
 RETURN jsonb_build_object('permit_id',permit,'permit_deadline',q.permit_deadline,'committed_at',n);
END $$;

-- commit_result: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.commit_result(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_run uuid,p_v bigint,p_g bigint,p_epoch bigint,p_fence bigint,p_namespace uuid,p_supervisor uuid,p_commit_id uuid,p_duration_ms integer,p_http_status integer,p_success boolean,p_failure_code text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; gate_now timestamptz; observed_now timestamptz; keys jsonb; k record;
BEGIN
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 IF p_commit_id IS NULL OR p_v IS NULL OR p_g IS NULL OR p_epoch IS NULL OR p_fence IS NULL OR LEAST(p_v,p_g,p_epoch,p_fence)<1
 OR p_duration_ms IS NULL OR p_duration_ms NOT BETWEEN 0 AND 30000 OR p_success IS NULL
 OR (p_http_status IS NOT NULL AND p_http_status NOT BETWEEN 200 AND 599)
 OR (p_success AND (p_http_status IS NULL OR p_failure_code IS NOT NULL))
 OR (NOT p_success AND (p_failure_code IS NULL OR p_failure_code NOT IN ('dns_failed','blocked_target','connect_failed','tls_failed','timeout','canceled','response_limit','protocol_error','unexpected_status')))
 OR (NOT p_success AND ((p_failure_code='unexpected_status') IS DISTINCT FROM (p_http_status IS NOT NULL))) THEN
  RAISE EXCEPTION 'invalid minimal result' USING ERRCODE='22023'; END IF;
 -- Recovery takes no User/Membership/Session lock and never reauthorizes a GET.
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,NULL,NULL,false);
 SELECT * INTO r FROM public.monitor_runs WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 -- Existing rows only: persistence may neither create nor refund a budget key.
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='global' AND budget_key='global' FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='workspace' AND budget_key=p_wid::text FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='project' AND budget_key=p_wid::text||'/'||p_pid::text FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='monitor' AND budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text FOR UPDATE;
 SELECT target_keys INTO keys FROM public.scheduler_reservations WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 FOR k IN SELECT kind,budget_key FROM (
  SELECT 'origin'::text kind,x->>'origin_key' budget_key FROM jsonb_array_elements(keys) x
  UNION SELECT 'ip',x->>'ip_key' FROM jsonb_array_elements(keys) x
 ) z ORDER BY CASE kind WHEN 'origin' THEN 0 ELSE 1 END,budget_key LOOP
  PERFORM 1 FROM public.scheduler_budget_state WHERE kind=k.kind AND budget_key=k.budget_key FOR UPDATE;
 END LOOP;
 SELECT * INTO q FROM public.scheduler_reservations WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM scheduler_private.lock_control(p_incarnation);
 PERFORM scheduler_private.system_identity('worker',p_incarnation);
 -- Fresh SPI after all waits. One observed DB clock, bounded by durable
 -- timestamps as D5 requires; a backward jump cannot renew an old Lease.
 SELECT clock_timestamp() INTO observed_now;
 SELECT GREATEST(observed_now,r.claimed_at,r.started_at,q.released_at,c.last_gate_at) INTO gate_now
 FROM public.scheduler_control c WHERE c.kind='worker' AND c.login_name=session_user AND c.incarnation=p_incarnation;
 IF gate_now>observed_now+interval '2 seconds' THEN RAISE EXCEPTION 'clock_untrusted' USING ERRCODE='P0001'; END IF;
 -- A committed replay acknowledges only an immutable original fact. It does
 -- not regain Lease authority, refresh timestamps or rewrite a projection.
 IF ROW(r.configuration_version,r.activation_generation,r.scheduler_epoch,r.fencing_token) IS DISTINCT FROM ROW(p_v,p_g,p_epoch,p_fence)
 OR r.lease_owner<>session_user OR r.worker_incarnation<>p_incarnation
 OR q.namespace_incarnation IS DISTINCT FROM p_namespace OR q.supervisor_incarnation IS DISTINCT FROM p_supervisor
 OR p_namespace IS NULL OR p_supervisor IS NULL THEN
  RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 IF r.result_commit_id IS NOT NULL THEN
  IF r.attempt_state<>'completed' OR r.result_commit_id<>p_commit_id
  OR ROW(r.duration_ms,r.http_status,r.success,r.failure_code) IS DISTINCT FROM ROW(p_duration_ms,p_http_status,p_success,p_failure_code) THEN
   RAISE EXCEPTION 'result_conflict' USING ERRCODE='P0001'; END IF;
  RETURN jsonb_build_object('run_id',p_run,'commit_id',p_commit_id,'state','committed');
 END IF;

 PERFORM 1 FROM public.monitor_runs x JOIN public.monitor_schedules s USING(workspace_id,project_id,monitor_id)
 JOIN public.scheduler_control c ON c.kind='worker' AND c.login_name=session_user AND c.incarnation=p_incarnation
 WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.run_id=p_run
 AND ROW(x.configuration_version,x.activation_generation,x.scheduler_epoch,x.fencing_token)=ROW(p_v,p_g,p_epoch,p_fence)
 AND x.lease_owner=session_user AND x.worker_incarnation=p_incarnation AND x.lease_until>gate_now
 AND x.attempt_state IN ('leased','started') AND x.stop_reason IS NULL AND x.result_commit_id IS NULL
 AND c.expires_at>gate_now AND NOT c.emergency_stop AND gate_now>=x.claimed_at
 AND gate_now<=transaction_timestamp()+interval '2 seconds';
 IF NOT FOUND OR q.namespace_incarnation IS DISTINCT FROM p_namespace OR q.supervisor_incarnation IS DISTINCT FROM p_supervisor THEN
  RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
  IF r.attempt_state<>'started' OR q.input_consumed_at IS NULL OR q.input_consumed_at<r.started_at
  OR q.reservation_state<>'released' OR q.release_basis<>'supervisor' OR q.termination_receipt IS NULL
  OR q.termination_receipt_id IS NULL OR q.stop_key_id IS NULL OR q.termination_network_digest IS NULL
  OR q.termination_process_digest IS NULL OR q.termination_retire_digest IS NULL OR p_namespace IS NULL OR p_supervisor IS NULL
  OR r.physical_release_confirmed_at IS NULL OR r.physical_release_confirmed_at IS DISTINCT FROM q.released_at
  OR q.released_at>gate_now THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
  UPDATE public.monitor_runs SET attempt_state='completed',finished_at=gate_now,result_commit_id=p_commit_id,duration_ms=p_duration_ms,
   http_status=p_http_status,success=p_success,failure_code=p_failure_code
  WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 -- Original Run fence and current projection are separate gates. A valid old
 -- completion remains audit only after Pause, PATCH or same-version renewal.
 UPDATE public.monitor_schedules s SET latest_result_run_id=p_run
 FROM public.http_monitors m, public.monitor_activation_states a
 WHERE s.workspace_id=p_wid AND s.project_id=p_pid AND s.monitor_id=p_mid
 AND m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid AND m.version=p_v
 AND a.workspace_id=p_wid AND a.project_id=p_pid AND a.monitor_id=p_mid
 AND a.activation_generation=p_g AND a.activation_configuration_version=p_v
 AND s.scheduler_epoch=p_epoch AND s.authorized_configuration_version=p_v AND s.authorized_activation_generation=p_g
 AND s.last_attempt_run_id=p_run AND s.last_fencing_token=p_fence;

 -- Advance only this confirmed, physically released completion, with the same
 -- current authorization. No replay, renewal, backfill or resource release.
 UPDATE public.monitor_schedules s
 SET next_run_id=uuidv7(),
     next_due_at=GREATEST(gate_now + m.interval_seconds*interval '1 second',
                          s.last_started_at + m.interval_seconds*interval '1 second',
                          s.next_start_not_before),
     blocked_reason=NULL,updated_at=GREATEST(s.updated_at,gate_now)
 FROM public.http_monitors m,public.monitor_activation_states a,public.scheduler_control d
 WHERE s.workspace_id=p_wid AND s.project_id=p_pid AND s.monitor_id=p_mid
 AND s.next_run_id=p_run AND s.last_attempt_run_id=p_run AND s.last_fencing_token=p_fence
 AND s.scheduler_epoch=p_epoch AND s.authorized_configuration_version=p_v
 AND s.authorized_activation_generation=p_g AND s.consent_protocol=1 AND s.expires_at>gate_now
 AND m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid AND m.version=p_v
 AND a.workspace_id=p_wid AND a.project_id=p_pid AND a.monitor_id=p_mid
 AND a.desired_state='enabled' AND a.activation_generation=p_g AND a.activation_configuration_version=p_v
 AND EXISTS(SELECT 1 FROM public.workspace_members b JOIN public.users u ON u.id=b.user_id
            WHERE b.workspace_id=p_wid AND b.role='owner' AND u.status='active')
 AND d.control_id='deployment' AND scheduler_private.private_gate_allows(d.gate,p_incarnation) AND NOT d.emergency_stop
 AND d.expires_at>gate_now AND d.disk_used_bytes<d.disk_budget_bytes*0.8
 AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable
                AND (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready
                     OR h.expires_at IS NULL OR h.expires_at<=gate_now));

 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=GREATEST(last_gate_at,gate_now)
 WHERE kind='worker' AND login_name=session_user AND incarnation=p_incarnation;
 RETURN jsonb_build_object('run_id',p_run,'commit_id',p_commit_id,'state','committed');
END $$;

-- recover_started: only the Gate predicate changes; all other statements unchanged.
CREATE OR REPLACE FUNCTION scheduler_private.recover_started(p_incarnation uuid,p_wid uuid,p_pid uuid,p_mid uuid,p_run uuid,p_v bigint,p_g bigint,p_epoch bigint,p_fence bigint,p_namespace uuid,p_supervisor uuid,p_reason text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog,scheduler_private SET lock_timeout='250ms' AS $$
DECLARE r public.monitor_runs%ROWTYPE; q public.scheduler_reservations%ROWTYPE; s public.monitor_schedules%ROWTYPE;
 keys jsonb; k record; observed_now timestamptz; gate_now timestamptz; previous xid8; released boolean; state text;
 next_id uuid; future_due timestamptz; seconds integer;
BEGIN
 PERFORM scheduler_private.system_identity('controller',p_incarnation);
 IF p_namespace IS NULL OR p_supervisor IS NULL OR p_v IS NULL OR p_g IS NULL OR p_epoch IS NULL OR p_fence IS NULL
 OR LEAST(p_v,p_g,p_epoch,p_fence)<1 OR p_reason IS NULL
 OR p_reason NOT IN ('lease_expired','worker_lost','commit_unknown','emergency_stop','egress_unavailable') THEN
  RAISE EXCEPTION 'invalid recovery identity' USING ERRCODE='22023'; END IF;
 -- D6 recovery suborder: no late User/Session/Membership locks. Scheduling a
 -- future identity grants no network authority; Claim/Start recheck the Owner.
 PERFORM scheduler_private.lock_parents(p_wid,p_pid,p_mid,NULL,NULL,false);
 SELECT * INTO r FROM public.monitor_runs WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND OR ROW(r.configuration_version,r.activation_generation,r.scheduler_epoch,r.fencing_token)
 IS DISTINCT FROM ROW(p_v,p_g,p_epoch,p_fence) THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 -- Existing budget rows only; no creation, refill, decrement or refund.
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='global' AND budget_key='global' FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='workspace' AND budget_key=p_wid::text FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='project' AND budget_key=p_wid::text||'/'||p_pid::text FOR UPDATE;
 PERFORM 1 FROM public.scheduler_budget_state WHERE kind='monitor' AND budget_key=p_wid::text||'/'||p_pid::text||'/'||p_mid::text FOR UPDATE;
 SELECT target_keys INTO keys FROM public.scheduler_reservations WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 FOR k IN SELECT kind,budget_key FROM (
  SELECT 'origin'::text kind,x->>'origin_key' budget_key FROM jsonb_array_elements(keys) x
  UNION SELECT 'ip',x->>'ip_key' FROM jsonb_array_elements(keys) x
 ) z ORDER BY CASE kind WHEN 'origin' THEN 0 ELSE 1 END,budget_key LOOP
  PERFORM 1 FROM public.scheduler_budget_state WHERE kind=k.kind AND budget_key=k.budget_key FOR UPDATE;
 END LOOP;
 SELECT * INTO q FROM public.scheduler_reservations WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 PERFORM 1 FROM public.scheduler_control WHERE control_id='deployment' FOR SHARE;
 SELECT last_transaction INTO previous FROM public.scheduler_control WHERE kind='controller' AND login_name=session_user AND incarnation=p_incarnation FOR UPDATE;
 IF NOT FOUND OR previous=pg_current_xact_id() THEN RAISE EXCEPTION 'one operation per transaction required' USING ERRCODE='25000'; END IF;
 -- New SPI statement/snapshot and observed DB time AFTER all protection waits.
 SELECT clock_timestamp() INTO observed_now;
 SELECT * INTO s FROM public.monitor_schedules WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid;
 SELECT GREATEST(observed_now,r.claimed_at,r.started_at,r.finished_at,q.released_at,s.updated_at,c.last_gate_at) INTO gate_now
 FROM public.scheduler_control c WHERE c.kind='controller' AND c.login_name=session_user AND c.incarnation=p_incarnation;
 PERFORM scheduler_private.system_identity('controller',p_incarnation);
 IF gate_now>observed_now+interval '2 seconds' OR gate_now>transaction_timestamp()+interval '2 seconds'
 OR NOT EXISTS(SELECT 1 FROM public.scheduler_control c WHERE c.kind='controller' AND c.login_name=session_user AND c.incarnation=p_incarnation AND c.expires_at>gate_now AND NOT c.emergency_stop)
 OR q.namespace_incarnation IS DISTINCT FROM p_namespace OR q.supervisor_incarnation IS DISTINCT FROM p_supervisor
 OR q.target_keys IS DISTINCT FROM keys OR r.started_at IS NULL OR r.attempt_state NOT IN ('started','unknown','canceled','completed') THEN
  RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 -- A valid, already committed observation wins; do not reclassify or schedule it.
 IF r.attempt_state='completed' THEN RETURN jsonb_build_object('run_id',p_run,'attempt_state','completed','released',r.physical_release_confirmed_at IS NOT NULL,'next_run_id',NULL,'next_due_at',NULL); END IF;
 released:=q.reservation_state='released' AND q.release_basis='supervisor' AND q.termination_receipt IS NOT NULL
 AND q.termination_receipt_id IS NOT NULL AND q.stop_key_id IS NOT NULL AND q.termination_network_digest IS NOT NULL
 AND q.termination_process_digest IS NOT NULL AND q.termination_retire_digest IS NOT NULL
 AND r.physical_release_confirmed_at IS NOT NULL AND r.physical_release_confirmed_at=q.released_at AND q.released_at<=gate_now;
 IF NOT released AND (q.reservation_state NOT IN ('reserved','quarantined') OR r.physical_release_confirmed_at IS NOT NULL) THEN
  RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
 state:=r.attempt_state;
 IF state='started' THEN
  IF p_reason='lease_expired' AND r.lease_until>gate_now THEN RAISE EXCEPTION 'candidate_invalid' USING ERRCODE='P0001'; END IF;
  state:='unknown';
  -- Absence of a committed target permit plus trusted physical release can
  -- prove no target capability under the approved install-after-commit path.
  -- It does not prove a known denial event: the existing control writer stores
  -- only stop_reason, and permit_denied / physical_stop_unconfirmed can leave
  -- the same value. Neither that value nor the Controller's reason supplies
  -- the missing provenance. Keep unknown; introduce no new field or authority.
  UPDATE public.monitor_runs SET attempt_state=state,finished_at=gate_now,stop_reason=COALESCE(stop_reason,p_reason)
  WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run;
 END IF;
 IF NOT released THEN
  UPDATE public.scheduler_reservations SET reservation_state='quarantined'
  WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND run_id=p_run AND reservation_state='reserved';
  UPDATE public.monitor_schedules SET blocked_reason='quarantined',updated_at=GREATEST(updated_at,gate_now)
  WHERE workspace_id=p_wid AND project_id=p_pid AND monitor_id=p_mid AND scheduler_epoch=p_epoch AND last_attempt_run_id=p_run AND next_run_id=p_run AND blocked_reason IS DISTINCT FROM 'quarantined';
 ELSE
  SELECT m.interval_seconds INTO seconds FROM public.http_monitors m WHERE m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid;
  future_due:=GREATEST(gate_now+seconds*interval '1 second',s.last_started_at+seconds*interval '1 second',s.next_start_not_before);
  -- Fresh snapshot rechecks current scope/version/authorization and readiness.
  -- Old Owner loss does not prevent quarantine/physical audit, only future work.
  UPDATE public.monitor_schedules x SET next_run_id=uuidv7(),next_due_at=future_due,blocked_reason=NULL,updated_at=GREATEST(x.updated_at,gate_now)
  FROM public.http_monitors m,public.monitor_activation_states a,public.scheduler_control d
  WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.next_run_id=p_run
  AND x.last_attempt_run_id=p_run AND x.last_fencing_token=p_fence AND x.scheduler_epoch=p_epoch
  AND m.workspace_id=p_wid AND m.project_id=p_pid AND m.id=p_mid AND m.version=p_v
  AND a.workspace_id=p_wid AND a.project_id=p_pid AND a.monitor_id=p_mid
  AND a.desired_state='enabled' AND a.activation_generation=p_g AND a.activation_configuration_version=p_v
  AND x.authorized_configuration_version=p_v AND x.authorized_activation_generation=p_g AND x.consent_protocol=1 AND x.expires_at>gate_now
  AND EXISTS(SELECT 1 FROM public.workspace_members b JOIN public.users u ON u.id=b.user_id WHERE b.workspace_id=p_wid AND b.role='owner' AND u.status='active')
  AND d.control_id='deployment' AND scheduler_private.private_gate_allows(d.gate,p_incarnation) AND NOT d.emergency_stop AND d.expires_at>gate_now AND d.disk_used_bytes<d.disk_budget_bytes*0.8
  AND NOT EXISTS(SELECT 1 FROM public.scheduler_control h WHERE h.kind='http' AND h.routable AND (h.projection_protocol IS DISTINCT FROM 'intent-v2' OR NOT h.status_ready OR h.expires_at IS NULL OR h.expires_at<=gate_now));
 END IF;
 SELECT x.next_run_id,x.next_due_at INTO next_id,future_due FROM public.monitor_schedules x
 WHERE x.workspace_id=p_wid AND x.project_id=p_pid AND x.monitor_id=p_mid AND x.scheduler_epoch=p_epoch
 AND x.last_attempt_run_id=p_run AND x.last_fencing_token=p_fence AND x.next_run_id<>p_run AND x.next_due_at IS NOT NULL;
 UPDATE public.scheduler_control SET last_transaction=pg_current_xact_id(),last_gate_at=GREATEST(last_gate_at,gate_now)
 WHERE kind='controller' AND login_name=session_user AND incarnation=p_incarnation;
 RETURN jsonb_build_object('run_id',p_run,'attempt_state',state,'released',released,'next_run_id',next_id,'next_due_at',future_due);
END $$;

-- Deliberately does NOT register/open private mode or create LOGINs.
COMMIT;
