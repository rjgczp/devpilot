FROM golang:1.24.3@sha256:81bf5927dc91aefb42e2bc3a5abdbe9bb3bae8ba8b107e2a4cf43ce3402534c6 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/api/ cmd/api/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -o /api ./cmd/api

FROM scratch AS api
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /api /api
USER 65534:65534
ENTRYPOINT ["/api"]

FROM build AS goose-build
RUN GOBIN=/tools go install -tags='no_clickhouse no_libsql no_mssql no_mysql no_sqlite3 no_vertica no_ydb' github.com/pressly/goose/v3/cmd/goose@v3.26.0

FROM postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336 AS migrate
COPY --from=goose-build /tools/goose /usr/local/bin/goose
COPY migrations/ /migrations/
COPY deploy/private/migrate.sh /migrate.sh
USER 65534:65534
ENTRYPOINT ["sh", "/migrate.sh"]
