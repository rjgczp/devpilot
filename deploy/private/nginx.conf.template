worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 16k;
    client_header_timeout 5s;
    client_body_timeout 10s;
    send_timeout 10s;
    keepalive_timeout 30s;
    map $uri $auth_key {
        default "";
        /api/v1/auth/login $binary_remote_addr;
        /api/v1/auth/register $binary_remote_addr;
    }
    map $uri $auth_global {
        default "";
        /api/v1/auth/login private_auth;
        /api/v1/auth/register private_auth;
    }
    limit_req_zone $auth_key zone=auth_peer:1m rate=5r/m;
    limit_req_zone $auth_global zone=auth_total:1m rate=1r/s;
    server {
        listen 8443 ssl default_server;
        server_name @@HOST@@;
        ssl_certificate /run/secrets/tls_cert;
        ssl_certificate_key /run/secrets/tls_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        if ($host != "@@HOST@@") { return 421; }
        @@ALLOW@@
        deny all;
        limit_req zone=auth_peer burst=5 nodelay;
        limit_req zone=auth_total burst=10 nodelay;
        limit_req_status 429;
        error_page 429 = @limited;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control no-store always;
        root /usr/share/nginx/html;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 12s;
        proxy_send_timeout 12s;
        proxy_next_upstream off;
        proxy_buffering off;
        location / {
            try_files $uri $uri/ /index.html;
        }
        location /api/ {
            proxy_pass http://api:8080;
        }
        # Registration predates the auth CSRF handler: enforce the same proof
        # at this private boundary without rewriting the registration API.
        location = /api/v1/auth/register {
            if ($http_origin != "@@ORIGIN@@") { return 403; }
            if ($http_x_devpilot_csrf != "1") { return 403; }
            if ($http_sec_fetch_site !~ "^(same-origin)?$") { return 403; }
            proxy_pass http://api:8080;
        }
        location @limited {
            default_type application/json;
            add_header Retry-After 60 always;
            return 429 '{"error":{"code":"rate_limited","message":"Too many requests. Try again later."}}';
        }
    }
}
