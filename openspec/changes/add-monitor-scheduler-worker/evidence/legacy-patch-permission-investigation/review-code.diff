+// Reproduces the unchanged failed fixture on schema7, before any corrective
+// GRANT or migration8. Expected denial is evidence, not a passing PATCH.
+func TestLegacyPatchOriginalFixtureSchemaSevenDiagnosis(t *testing.T) {
+	db := openDB(t)
+	ctx := context.Background()
+	dir := filepath.Join(root(), "migrations")
+	goose(t, dir, "up-to 7", true)
+	t.Cleanup(func() { goose(t, dir, "down-to 0", true) })
+	f, m := monitorFixture(t, db)
+	if _, err := db.Exec(ctx, `CREATE ROLE checkpoint1_legacy LOGIN PASSWORD 'disposable_fixture_only'; GRANT USAGE ON SCHEMA public TO checkpoint1_legacy; GRANT SELECT,UPDATE ON users,sessions,workspaces,workspace_members,projects,http_monitors,monitor_activation_states TO checkpoint1_legacy`); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if _, err := db.Exec(ctx, `DROP OWNED BY checkpoint1_legacy; DROP ROLE checkpoint1_legacy`); err != nil {
+			t.Error(err)
+		}
+	})
+	cfg := db.Config()
+	cfg.ConnConfig.User, cfg.ConnConfig.Password = "checkpoint1_legacy", "disposable_fixture_only"
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Close)
+	legacyPermissionSnapshot(t, db, "schema7-original-fixture", "checkpoint1_legacy")
+	var captured *pgconn.PgError
+	_, err = legacyPermissionStore(t, pool, &captured).Update(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitorInput("schema7 original fixture PATCH"), monitor.ETag(m))
+	if err != user.ErrInternal || captured == nil || captured.Code != "42501" || captured.Message != "permission denied for table http_monitors" || captured.Where != "" {
+		t.Fatalf("different baseline failure: classified=%v raw=%+v", err, captured)
+	}
+	if queryInt(t, db, `SELECT version FROM http_monitors WHERE id=$1`, m.ID) != 1 {
+		t.Fatal("denied PATCH mutated monitor")
+	}
+	t.Log("Schema7 original fixture FAILS identical PATCH before Migration8; no corrective privilege granted")
+}
