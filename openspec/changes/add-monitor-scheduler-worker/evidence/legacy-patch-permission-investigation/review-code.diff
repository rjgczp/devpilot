+// Schema7's shared POST/PATCH statement names these INSERT columns even when
+// the PATCH branch inserts zero rows. This is not a scheduler privilege.
+const legacyPatchInsertColumns = `GRANT INSERT(workspace_id,project_id,name,url,method,interval_seconds,timeout_seconds,expected_status,created_by_user_id) ON public.http_monitors TO checkpoint1_legacy`
+
+// Records the real Store statement and driver error before Store classification.
+// Never records arguments (session digest and monitor URL are not diagnostics).
+type legacyPermissionTx struct {
+	pgx.Tx
+	t   *testing.T
+	err **pgconn.PgError
+}
+
+func (tx legacyPermissionTx) QueryRow(ctx context.Context, sql string, args ...any) pgx.Row {
+	return legacyPermissionRow{Row: tx.Tx.QueryRow(ctx, sql, args...), tx: tx, sql: sql}
+}
+
+type legacyPermissionRow struct {
+	pgx.Row
+	tx  legacyPermissionTx
+	sql string
+}
+
+func (r legacyPermissionRow) Scan(dest ...any) error {
+	err := r.Row.Scan(dest...)
+	var p *pgconn.PgError
+	if errors.As(err, &p) {
+		*r.tx.err = p
+		r.tx.t.Logf("driver error: SQLSTATE=%s message=%q where=%q internal_query=%q schema=%q table=%q routine=%q position=%d\nSQL (arguments withheld):\n%s", p.Code, p.Message, p.Where, p.InternalQuery, p.SchemaName, p.TableName, p.Routine, p.Position, r.sql)
+	}
+	return err
+}
+
+func legacyPermissionStore(t *testing.T, pool *pgxpool.Pool, captured **pgconn.PgError) monitor.Store {
+	t.Helper()
+	return monitor.Store{Pool: workspaceObservedDB{Pool: pool, wrap: func(tx pgx.Tx) pgx.Tx {
+		var identity string
+		if err := tx.QueryRow(context.Background(), `SELECT json_build_object('session_user',session_user,'current_user',current_user,'pid',pg_backend_pid(),'isolation',current_setting('transaction_isolation'))::text`).Scan(&identity); err != nil {
+			t.Error(err)
+		}
+		t.Log("PATCH transaction identity: " + identity)
+		return legacyPermissionTx{Tx: tx, t: t, err: captured}
+	}}}
+}
