+func TestLegacyPatchColumnPrivilegesAcrossMigration(t *testing.T) {
+	db := openDB(t)
+	ctx := context.Background()
+	dir := filepath.Join(root(), "migrations")
+	goose(t, dir, "up-to 7", true)
+	t.Cleanup(func() { goose(t, dir, "down-to 0", true) })
+	f, m := monitorFixture(t, db)
+	if _, err := db.Exec(ctx, `CREATE ROLE checkpoint1_legacy LOGIN PASSWORD 'disposable_fixture_only'; GRANT USAGE ON SCHEMA public TO checkpoint1_legacy; GRANT SELECT,UPDATE ON users,sessions,workspaces,workspace_members,projects,http_monitors,monitor_activation_states TO checkpoint1_legacy`); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if _, err := db.Exec(ctx, `DROP OWNED BY checkpoint1_legacy; DROP ROLE checkpoint1_legacy`); err != nil {
+			t.Error(err)
+		}
+	})
+	cfg := db.Config()
+	cfg.ConnConfig.User, cfg.ConnConfig.Password = "checkpoint1_legacy", "disposable_fixture_only"
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Close)
+	legacyPermissionSnapshot(t, db, "schema7-before-column-fix", "checkpoint1_legacy")
+	if _, err = db.Exec(ctx, legacyPatchInsertColumns); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("fixture-only corrective SQL: " + legacyPatchInsertColumns)
+	before := legacyPermissionSnapshot(t, db, "schema7-fixed", "checkpoint1_legacy")
+	var captured *pgconn.PgError
+	s := legacyPermissionStore(t, pool, &captured)
+	m, err = s.Update(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitorInput("schema7 successful PATCH"), monitor.ETag(m))
+	if err != nil || captured != nil {
+		t.Fatalf("schema7 corrected baseline PATCH: %v / %+v", err, captured)
+	}
+	if m.Version != "2" {
+		t.Fatal("schema7 PATCH did not commit")
+	}
+	goose(t, dir, "up-to 8", true)
+	after := legacyPermissionSnapshot(t, db, "schema8-same-login", "checkpoint1_legacy")
+	// Existing table/column ACLs, function EXECUTE and role memberships must
+	// survive exactly. New scheduler objects are deliberately absent in before.
+	var b, a map[string]any
+	if err = json.Unmarshal([]byte(before), &b); err != nil {
+		t.Fatal(err)
+	}
+	if err = json.Unmarshal([]byte(after), &a); err != nil {
+		t.Fatal(err)
+	}
+	for _, key := range []string{"role", "memberships"} {
+		if !reflect.DeepEqual(b[key], a[key]) {
+			t.Fatal("legacy identity changed", key)
+		}
+	}
+	for _, key := range []string{"tables", "functions"} {
+		id := "table"
+		if key == "functions" {
+			id = "function"
+		}
+		for _, old := range b[key].([]any) {
+			found := false
+			for _, next := range a[key].([]any) {
+				if old.(map[string]any)[id] == next.(map[string]any)[id] {
+					// M8 legitimately adds different principals to raw ACLs.
+					// Compare this legacy principal plus PUBLIC, retaining all
+					// effective privilege booleans and object owner metadata.
+					if !reflect.DeepEqual(legacyPrincipalACL(old), legacyPrincipalACL(next)) {
+						t.Fatalf("legacy ACL changed: %v", old.(map[string]any)[id])
+					}
+					found = true
+				}
+			}
+			if !found {
+				t.Fatal("legacy object disappeared", old)
+			}
+		}
+	}
+	if queryInt(t, db, `SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='scheduler_private' AND has_function_privilege('checkpoint1_legacy',p.oid,'EXECUTE')`) != 0 {
+		t.Fatal("legacy gained scheduler function EXECUTE")
+	}
+	for _, sql := range []string{
+		`SELECT * FROM public.monitor_schedules`, `SELECT * FROM public.monitor_runs`,
+		`UPDATE public.monitor_schedules SET next_due_at=NULL`, `DELETE FROM public.monitor_runs`,
+		`SELECT scheduler_private.authorize(NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,60)`,
+		`SELECT scheduler_private.claim(NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL)`,
+		`INSERT INTO public.http_monitors(id) VALUES(uuidv7())`,
+	} {
+		_, err = pool.Exec(ctx, sql)
+		var denied *pgconn.PgError
+		if !errors.As(err, &denied) || denied.Code != "42501" {
+			t.Fatalf("expected privilege denial %s: %v", sql, err)
+		}
+		t.Logf("legacy negative boundary SQLSTATE=%s SQL=%s", denied.Code, sql)
+	}
+	// Populate a real authorization via the separately approved API identity;
+	// the unchanged legacy PATCH must revoke it through the private trigger
+	// without obtaining direct EXECUTE or table privileges itself.
+	activationSeed(t, db, m, "next_enable_allowed_at=statement_timestamp()-interval '1s'")
+	activation := activationRead(t, db, f.od, m)
+	_, err = (monitor.Store{Pool: db}).ExecutionAuthorize(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitor.ExecutionAuthorizationInput{ConfigurationVersion: m.Version, ConsentProfile: "periodic-http-get-v1", AuthorizationSeconds: 60}, monitor.ActivationETag(activation))
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, err = s.Update(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitorInput("schema8 same old login PATCH"), monitor.ETag(m))
+	if err != nil || captured != nil || m.Version != "3" {
+		t.Fatalf("schema8 old login PATCH: %v / %+v", err, captured)
+	}
+	if queryInt(t, db, `SELECT count(*) FROM monitor_schedules WHERE monitor_id=$1 AND authorized_activation_generation IS NULL AND expires_at IS NULL AND next_due_at IS NULL AND scheduler_epoch=2`, m.ID) != 1 {
+		t.Fatal("legacy PATCH failed to revoke new authorization")
+	}
+	if queryInt(t, db, `SELECT count(*) FROM monitor_runs`) != 0 {
+		t.Fatal("legacy PATCH created Run")
+	}
+	t.Log("schema7 and schema8 PATCH committed with same non-owner LOGIN; old table/column/function ACLs unchanged; new scheduler capabilities denied; private trigger revoked grant")
+}
+
+func legacyPrincipalACL(value any) any {
+	switch v := value.(type) {
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for key, child := range v {
+			if key == "acl" {
+				var entries []any
+				if list, ok := child.([]any); ok {
+					for _, entry := range list {
+						s := entry.(string)
+						if strings.HasPrefix(s, "checkpoint1_legacy=") || strings.HasPrefix(s, "=") {
+							entries = append(entries, s)
+						}
+					}
+				}
+				out[key] = entries
+			} else {
+				out[key] = legacyPrincipalACL(child)
+			}
+		}
+		return out
+	case []any:
+		out := make([]any, len(v))
+		for i := range v {
+			out[i] = legacyPrincipalACL(v[i])
+		}
+		return out
+	default:
+		return value
+	}
+}
