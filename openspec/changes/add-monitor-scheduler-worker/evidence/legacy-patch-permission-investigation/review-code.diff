+func legacyPermissionSnapshot(t *testing.T, db *pgxpool.Pool, label, role string) string {
+	t.Helper()
+	var snapshot string
+	err := db.QueryRow(context.Background(), `SELECT jsonb_build_object(
+ 'database',(SELECT jsonb_build_object('owner',pg_get_userbyid(datdba),'acl',datacl,'create',has_database_privilege($1,oid,'CREATE'),'temp',has_database_privilege($1,oid,'TEMP')) FROM pg_database WHERE datname=current_database()),
+ 'schemas',(SELECT jsonb_agg(jsonb_build_object('schema',nspname,'owner',pg_get_userbyid(nspowner),'acl',nspacl,'usage',has_schema_privilege($1,oid,'USAGE'),'create',has_schema_privilege($1,oid,'CREATE')) ORDER BY nspname) FROM pg_namespace WHERE nspname IN ('public','scheduler_private')),
+ 'role',(SELECT to_jsonb(r) FROM (SELECT rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls FROM pg_roles WHERE rolname=$1) r),
+ 'memberships',(SELECT coalesce(jsonb_agg(parent.rolname ORDER BY parent.rolname),'[]') FROM pg_auth_members a JOIN pg_roles parent ON parent.oid=a.roleid JOIN pg_roles child ON child.oid=a.member WHERE child.rolname=$1),
+ 'tables',(SELECT jsonb_agg(jsonb_build_object('table',c.relname,'owner',pg_get_userbyid(c.relowner),'acl',c.relacl,'rls',c.relrowsecurity,'select',has_table_privilege($1,c.oid,'SELECT'),'insert',has_table_privilege($1,c.oid,'INSERT'),'update',has_table_privilege($1,c.oid,'UPDATE'),'columns',(SELECT jsonb_agg(jsonb_build_object('name',a.attname,'acl',a.attacl,'insert',has_column_privilege($1,c.oid,a.attnum,'INSERT'),'update',has_column_privilege($1,c.oid,a.attnum,'UPDATE')) ORDER BY a.attnum) FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped)) ORDER BY c.relname) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind='r' AND c.relname<>'goose_db_version'),
+ 'functions',(SELECT jsonb_agg(jsonb_build_object('function',p.oid::regprocedure::text,'owner',pg_get_userbyid(p.proowner),'definer',p.prosecdef,'settings',p.proconfig,'acl',p.proacl,'execute',has_function_privilege($1,p.oid,'EXECUTE')) ORDER BY p.oid::regprocedure::text) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('public','scheduler_private')),
+ 'triggers',(SELECT jsonb_agg(jsonb_build_object('table',c.relname,'definition',pg_get_triggerdef(t.oid),'function',p.oid::regprocedure::text,'definer',p.prosecdef,'owner',pg_get_userbyid(p.proowner)) ORDER BY c.relname,t.tgname) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace JOIN pg_proc p ON p.oid=t.tgfoid WHERE NOT t.tgisinternal AND n.nspname='public'),
+ 'dependencies',(SELECT jsonb_agg(jsonb_build_object('table',c.relname,'constraint',pg_get_constraintdef(k.oid)) ORDER BY c.relname,k.conname) FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname IN ('http_monitors','monitor_activation_states')),
+ 'defaults',(SELECT jsonb_agg(pg_get_expr(d.adbin,d.adrelid)) FROM pg_attrdef d WHERE d.adrelid='public.http_monitors'::regclass)
+ )::text`, role).Scan(&snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("ACL snapshot %s: %s", label, snapshot)
+	return snapshot
+}
