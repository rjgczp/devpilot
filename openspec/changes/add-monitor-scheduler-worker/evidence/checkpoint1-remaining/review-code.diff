@@ -0,0 +1,173 @@
+//go:build integration
+
+package integration
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/rjgczp/devpilot/internal/config"
+	"github.com/rjgczp/devpilot/internal/monitor"
+)
+
+func checkpointHTTPServer(t *testing.T, db *pgxpool.Pool) (*httptest.Server, *http.Client, *bytes.Buffer) {
+	t.Helper()
+	logs := new(bytes.Buffer)
+	origin, err := config.ParseOrigin("https://app.example.com")
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := monitor.New(monitor.Store{Pool: db}, config.AuthConfig{Mode: "production", Origin: origin}, slog.New(slog.NewJSONHandler(logs, nil)))
+	s := httptest.NewUnstartedServer(h)
+	if address := os.Getenv("MONITOR_PROBE_HTTP_ADDR"); address != "" {
+		s.Listener.Close()
+		s.Listener, err = net.Listen("tcp4", address)
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	s.Start()
+	t.Cleanup(s.Close)
+	transport := &http.Transport{Proxy: nil}
+	t.Cleanup(transport.CloseIdleConnections)
+	return s, &http.Client{Transport: transport}, logs
+}
+func checkpointHTTP(t *testing.T, c *http.Client, server, method, path, body, token, tag string, modify func(http.Header)) (int, http.Header, []byte) {
+	t.Helper()
+	r, err := http.NewRequest(method, server+path, strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if token != "" {
+		r.AddCookie(&http.Cookie{Name: "__Host-devpilot_session", Value: token})
+	}
+	if method != "GET" {
+		r.Header.Set("Origin", "https://app.example.com")
+		r.Header.Set("X-DevPilot-CSRF", "1")
+		r.Header.Set("Content-Type", "application/json")
+	}
+	if tag != "" {
+		r.Header.Set("If-Match", tag)
+	}
+	if modify != nil {
+		modify(r.Header)
+	}
+	resp, err := c.Do(r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 16385))
+	if err != nil || len(raw) > 16384 {
+		t.Fatal("unbounded response", err)
+	}
+	return resp.StatusCode, resp.Header, raw
+}
+func TestCheckpointOneAuthorizationRealHTTPStrictContract(t *testing.T) {
+	db := workspaceDB(t)
+	ctx := context.Background()
+	f, m := monitorFixture(t, db)
+	server, client, logs := checkpointHTTPServer(t, db)
+	path := "/api/v1/workspaces/" + m.WorkspaceID + "/projects/" + m.ProjectID + "/monitors/" + m.ID + "/execution-authorization"
+	a := activationRead(t, db, f.od, m)
+	tag := monitor.ActivationETag(a)
+	valid := `{"configuration_version":"1","consent_profile":"periodic-http-get-v1","authorization_seconds":60}`
+	cases := []struct {
+		name, body, token, tag string
+		status                 int
+		modify                 func(http.Header)
+	}{
+		{name: "cookie-first", body: valid, tag: "", status: 401},
+		{name: "member-before-precondition", body: valid, token: f.memberToken, status: 403},
+		{name: "foreign-before-precondition", body: valid, token: f.otherToken, status: 404},
+		{name: "required", body: valid, token: f.ownerToken, status: 428},
+		{name: "stale", body: valid, token: f.ownerToken, tag: `"monitor-activation:` + m.ID + `:1:99"`, status: 412},
+	}
+	invalidBodies := []string{`null`, `[]`, `{}`, valid + ` {}`, strings.TrimSuffix(valid, "}") + `,"extra":true}`, strings.TrimSuffix(valid, "}") + `,"configuration_\u0076ersion":"1"}`, strings.Replace(valid, `:60`, `:null`, 1), strings.Replace(valid, `:60`, `:"60"`, 1), strings.Replace(valid, `:60`, `:60.0`, 1), strings.Replace(valid, `:60`, `:6e1`, 1), strings.Replace(valid, `"1"`, `null`, 1), strings.Replace(valid, `"1"`, `"\ud800"`, 1), string(append([]byte(valid[:len(valid)-1]), 255, '}'))}
+	for _, body := range invalidBodies {
+		cases = append(cases, struct {
+			name, body, token, tag string
+			status                 int
+			modify                 func(http.Header)
+		}{name: "strict-json", body: body, token: f.ownerToken, tag: tag, status: 400})
+	}
+	for _, v := range []string{"0", "01", "+1", "9223372036854775808"} {
+		cases = append(cases, struct {
+			name, body, token, tag string
+			status                 int
+			modify                 func(http.Header)
+		}{name: "version", body: strings.Replace(valid, `"1"`, `"`+v+`"`, 1), token: f.ownerToken, tag: tag, status: 422})
+	}
+	for _, h := range []struct {
+		name   string
+		status int
+		edit   func(http.Header)
+	}{
+		{"weak", 400, func(h http.Header) { h.Set("If-Match", "W/"+tag) }},
+		{"wildcard", 400, func(h http.Header) { h.Set("If-Match", "*") }},
+		{"duplicate", 400, func(h http.Header) { h.Add("If-Match", tag) }},
+		{"multivalue", 400, func(h http.Header) { h.Set("If-Match", tag+","+tag) }},
+		{"media", 415, func(h http.Header) { h.Set("Content-Type", "text/plain") }},
+		{"duplicate-media", 415, func(h http.Header) { h.Add("Content-Type", "application/json") }},
+		{"encoding", 415, func(h http.Header) { h.Set("Content-Encoding", "identity") }},
+		{"origin", 403, func(h http.Header) { h.Set("Origin", "null") }},
+		{"csrf", 403, func(h http.Header) { h.Del("X-DevPilot-CSRF") }},
+	} {
+		cases = append(cases, struct {
+			name, body, token, tag string
+			status                 int
+			modify                 func(http.Header)
+		}{name: h.name, body: valid, token: f.ownerToken, tag: tag, status: h.status, modify: h.edit})
+	}
+	cases = append(cases, struct {
+		name, body, token, tag string
+		status                 int
+		modify                 func(http.Header)
+	}{name: "1025", body: valid + strings.Repeat(" ", 1025-len(valid)), token: f.ownerToken, tag: tag, status: 413})
+	for i, tc := range cases {
+		status, headers, raw := checkpointHTTP(t, client, server.URL, "PUT", path, tc.body, tc.token, tc.tag, tc.modify)
+		if status != tc.status {
+			t.Fatalf("case %d %s: HTTP %d want %d body=%s", i, tc.name, status, tc.status, raw)
+		}
+		if headers.Get("ETag") != "" || headers.Get("Set-Cookie") != "" || bytes.Contains(raw, []byte(`"data"`)) {
+			t.Fatal("failure carried success data", tc.name)
+		}
+		if activationRead(t, db, f.od, m).ActivationGeneration != "1" || queryInt(t, db, `SELECT count(*) FROM monitor_schedules WHERE monitor_id=$1`, m.ID) != 0 {
+			t.Fatal("rejected request changed authorization", tc.name)
+		}
+	}
+	status, headers, raw := checkpointHTTP(t, client, server.URL, "PUT", path, valid+strings.Repeat(" ", 1024-len(valid)), f.ownerToken, tag, nil)
+	var grant struct {
+		Data monitor.ExecutionAuthorization
+	}
+	if status != 200 || json.Unmarshal(raw, &grant) != nil || grant.Data.ActivationGeneration != "2" || grant.Data.EffectiveAuthorization {
+		t.Fatal("1024-byte confirmed grant", status, string(raw))
+	}
+	if headers.Get("ETag") != monitor.ActivationETag(activationRead(t, db, f.od, m)) || headers.Get("Cache-Control") != "no-store" || headers.Get("X-Content-Type-Options") != "nosniff" {
+		t.Fatal("grant response contract")
+	}
+	status, _, raw = checkpointHTTP(t, client, server.URL, "GET", strings.TrimSuffix(path, "execution-authorization")+"execution-status", "", f.memberToken, "", nil)
+	var result struct{ Data monitor.ExecutionStatus }
+	if status != 200 || json.Unmarshal(raw, &result) != nil || result.Data.AuthorizationState != "valid" || result.Data.SchedulingState != "blocked" {
+		t.Fatal("Member status", status, string(raw))
+	}
+	if queryInt(t, db, `SELECT count(*) FROM monitor_runs`) != 0 {
+		t.Fatal("HTTP API created a run")
+	}
+	if strings.Contains(logs.String(), f.ownerToken) || strings.Contains(logs.String(), "private-path") {
+		t.Fatal("sensitive HTTP log")
+	}
+	if _, err := (monitor.Store{Pool: db}).ExecutionStatus(ctx, f.xd, m.WorkspaceID, m.ProjectID, m.ID); err == nil {
+		t.Fatal("cross-tenant status visible")
+	}
+}
diff --git a/tests/integration/scheduler_checkpoint1_migration_concurrency_test.go b/tests/integration/scheduler_checkpoint1_migration_concurrency_test.go
new file mode 100644
index 0000000..2b88e34
--- /dev/null
+++ b/tests/integration/scheduler_checkpoint1_migration_concurrency_test.go
@@ -0,0 +1,189 @@
+//go:build integration
+
+package integration
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/rjgczp/devpilot/internal/monitor"
+)
+
+type checkpointGooseResult struct {
+	err    error
+	output []byte
+}
+
+func checkpointStartGoose(t *testing.T, dir string) <-chan checkpointGooseResult {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Second)
+	t.Cleanup(cancel)
+	cmd := exec.CommandContext(ctx, "goose", "-env=none", "-dir", dir, "-timeout", "30s", "up-to", "8")
+	for _, v := range os.Environ() {
+		if !strings.HasPrefix(v, "GOOSE_") {
+			cmd.Env = append(cmd.Env, v)
+		}
+	}
+	cmd.Env = append(cmd.Env, "GOOSE_DRIVER=postgres", "GOOSE_DBSTRING="+os.Getenv("TEST_DATABASE_URL"))
+	ch := make(chan checkpointGooseResult, 1)
+	go func() { out, err := cmd.CombinedOutput(); ch <- checkpointGooseResult{err, out} }()
+	return ch
+}
+func checkpointAwaitGoose(t *testing.T, ch <-chan checkpointGooseResult) {
+	t.Helper()
+	r := <-ch
+	if r.err != nil {
+		t.Fatalf("migration failed; diagnostic bytes=%d", len(r.output))
+	}
+	t.Log("native Goose 7->8 confirmed commit")
+}
+func checkpointMigrationWait(t *testing.T, db *pgxpool.Pool, advisory bool) int {
+	t.Helper()
+	until := time.Now().Add(time.Second)
+	for time.Now().Before(until) {
+		var pid int
+		sql := `SELECT pid FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND state='active' AND wait_event_type='Lock' AND query LIKE '%LOCK TABLE public.monitor_activation_states%' LIMIT 1`
+		if advisory {
+			sql = `SELECT pid FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND state='active' AND wait_event='advisory' LIMIT 1`
+		}
+		if db.QueryRow(context.Background(), sql).Scan(&pid) == nil {
+			return pid
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("migration barrier not observed within existing API budget")
+	return 0
+}
+func TestCheckpointOneOldWritersStraddleMigration(t *testing.T) {
+	for _, order := range []string{"activation-first", "patch-first", "migration-first"} {
+		t.Run(order, func(t *testing.T) {
+			db := openDB(t)
+			ctx := context.Background()
+			dir := filepath.Join(root(), "migrations")
+			goose(t, dir, "up-to 7", true)
+			t.Cleanup(func() { goose(t, dir, "down-to 0", true) })
+			f, m := monitorFixture(t, db)
+			if _, err := db.Exec(ctx, `CREATE ROLE checkpoint1_legacy LOGIN PASSWORD 'disposable_fixture_only'; GRANT USAGE ON SCHEMA public TO checkpoint1_legacy;GRANT SELECT,UPDATE ON users,sessions,workspaces,workspace_members,projects,http_monitors,monitor_activation_states TO checkpoint1_legacy`); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if _, err := db.Exec(ctx, `DROP OWNED BY checkpoint1_legacy;DROP ROLE checkpoint1_legacy`); err != nil {
+					t.Error(err)
+				}
+			})
+			cfg := db.Config()
+			cfg.ConnConfig.User = "checkpoint1_legacy"
+			cfg.ConnConfig.Password = "disposable_fixture_only"
+			oldPool, err := pgxpool.NewWithConfig(ctx, cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(oldPool.Close)
+			old := monitor.SchemaSevenFixtureStore{Pool: oldPool}
+			a, err := old.ActivationDetail(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			pause := newWorkspacePause(t)
+			pid := make(chan int, 1)
+			done := make(chan error, 1)
+			if order == "migration-first" {
+				blocker, err := db.Begin(ctx)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer blocker.Rollback(ctx)
+				if _, err = blocker.Exec(ctx, `SELECT pg_advisory_xact_lock(181108)`); err != nil {
+					t.Fatal(err)
+				}
+				temp := t.TempDir()
+				files, err := filepath.Glob(filepath.Join(dir, "*.sql"))
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, file := range files {
+					raw, err := os.ReadFile(file)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if strings.HasPrefix(filepath.Base(file), "00008_") {
+						raw = []byte(strings.Replace(string(raw), "-- +goose Down", "SELECT pg_advisory_xact_lock(181108);\n-- +goose Down", 1))
+					}
+					if err = os.WriteFile(filepath.Join(temp, filepath.Base(file)), raw, 0600); err != nil {
+						t.Fatal(err)
+					}
+				}
+				migration := checkpointStartGoose(t, temp)
+				mp := checkpointMigrationWait(t, db, true)
+				go func() {
+					_, e := (monitor.SchemaSevenFixtureStore{Pool: workspaceObservedDB{Pool: oldPool, pid: pid}}).ActivationUpdate(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitor.ActivationInput{DesiredState: "enabled", ConfigurationVersion: "1"}, monitor.ActivationETag(a))
+					done <- e
+				}()
+				actor := <-pid
+				waitActivationBlock(t, db, actor)
+				schedulerLockReceipt(t, db, "Migration holds table locks; old API waits Activation", mp, actor)
+				if err = blocker.Commit(ctx); err != nil {
+					t.Fatal(err)
+				}
+				checkpointAwaitGoose(t, migration)
+				monitorWant(t, <-done, monitor.ErrPreconditionFailed)
+				if activationRead(t, db, f.od, m).ActivationGeneration != "2" {
+					t.Fatal("migration-first reused tag")
+				}
+			} else {
+				observed := workspaceObservedDB{Pool: oldPool, pid: pid, wrap: func(tx pgx.Tx) pgx.Tx {
+					if order == "activation-first" {
+						return activationObservedTx{Tx: tx, after: func(ctx context.Context, stage string) {
+							if stage == "activation" {
+								pause.stop(ctx)
+							}
+						}}
+					}
+					return monitorObservedTx{Tx: tx, after: func(ctx context.Context, stage string) {
+						if stage == "monitor" {
+							pause.stop(ctx)
+						}
+					}}
+				}}
+				go func() {
+					var e error
+					if order == "activation-first" {
+						_, e = (monitor.SchemaSevenFixtureStore{Pool: observed}).ActivationUpdate(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitor.ActivationInput{DesiredState: "enabled", ConfigurationVersion: "1"}, monitor.ActivationETag(a))
+					} else {
+						_, e = (monitor.Store{Pool: observed}).Update(ctx, f.od, m.WorkspaceID, m.ProjectID, m.ID, monitorInput("old PATCH after schema8"), monitor.ETag(m))
+					}
+					done <- e
+				}()
+				actor := <-pid
+				pause.wait(t)
+				migration := checkpointStartGoose(t, dir)
+				if order == "activation-first" {
+					mp := checkpointMigrationWait(t, db, false)
+					schedulerLockReceipt(t, db, "old Activation writer precedes Migration retirement", actor, mp)
+					pause.resume()
+					monitorWant(t, <-done, nil)
+					checkpointAwaitGoose(t, migration)
+				} else {
+					checkpointAwaitGoose(t, migration)
+					schedulerLockReceipt(t, db, "Migration commits before old PATCH DML; no child-to-parent cycle", actor)
+					pause.resume()
+					monitorWant(t, <-done, nil)
+				}
+				after := activationRead(t, db, f.od, m)
+				if after.ActivationGeneration != "3" || after.DesiredState != "disabled" {
+					t.Fatal("old writer/migration generation order", after.ActivationGeneration)
+				}
+			}
+			if queryInt(t, db, `SELECT count(*) FROM monitor_schedules`)+queryInt(t, db, `SELECT count(*) FROM monitor_runs`) != 0 {
+				t.Fatal("straddling writer granted execution")
+			}
+		})
+	}
+}
