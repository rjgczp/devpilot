+	if err != nil || !bytes.HasPrefix(probe, []byte("//go:build executionnet && linux\n")) {
+		t.Fatal("Probe test entry must be Linux-only")
+	}
+	// Inspect a real ordinary Linux API artifact, not only the host's build graph.
